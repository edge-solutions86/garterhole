{
  "name": "garterhole",
  "version": "1.0.0",
  "private": true,
  "description": "Method, composition, striking and tower tooling for change ringing bands",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "node scripts/verify.mjs",
    "coverage": "vitest run --coverage",
    "surface": "node scripts/routes.mjs",
    "surface:check": "node scripts/routes.mjs --check",
    "bench": "node scripts/bench.mjs",
    "smoke": "node scripts/smoke.mjs",
    "release:check": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "@vitest/coverage-v8": "3.0.5",
    "eslint": "9.19.0",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "vitest": "3.0.5"
  },
  "bin": {
    "garterhole": "./bin/garterhole.js"
  },
  "keywords": [
    "change-ringing",
    "bells",
    "method",
    "composition",
    "striking",
    "campanology"
